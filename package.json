{
  "name": "shea-pos",
  "version": "0.1.3",
  "private": true,
  "description": "Offline-first Shea point of sale",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "yarn build && electron .",
    "dev": "yarn build:electron && concurrently -k \"node scripts/vite-dev.mjs\" \"tsc -p tsconfig.electron.json --watch\" \"node scripts/electron-dev.mjs\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test:integration": "npm run build && cross-env ELECTRON_RUN_AS_NODE=1 electron dist-electron/integration-test.js",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "dist": "yarn build && electron-builder",
    "dist:win": "yarn build && electron-builder --win nsis --x64",
    "dist:win:publish": "yarn build && electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "@fontsource/urbanist": "^5.3.0",
    "@fontsource/zain": "^5.3.0",
    "@zikosl/shea-pos-protocol": "file:../packages/pos-protocol",
    "better-sqlite3": "13.0.3",
    "bwip-js": "^4.11.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "1.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3",
    "vite": "8.2.2",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.openzey.shea.pos",
    "productName": "Shea POS",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://shea.openzey.com/downloads/pos"
      }
    ],
    "npmRebuild": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Shea-POS-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}